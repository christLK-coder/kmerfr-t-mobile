{
  "expo": {
    "name": "KmerFret",
    "slug": "kmerfret",
    "version": "2.0.0",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "kmerfret",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1B5E20"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1B5E20"
      },
      "package": "cm.kmerfret.app",
      "googleServicesFile": "./google-services.json",
      "versionCode": 2,
      "compileSdkVersion": 35,
      "targetSdkVersion": 35,
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.SEND_SMS",
        "android.permission.VIBRATE",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
    },
    "ios": {
      "bundleIdentifier": "cm.kmerfret.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Scanner les documents du port et les QR Codes de livraison",
        "NSLocationWhenInUseUsageDescription": "Suivre votre position pour les missions de transport",
        "NSLocationAlwaysUsageDescription": "Télémétrie continue pendant les missions de transport",
        "NSPhotoLibraryUsageDescription": "Importer des documents portuaires depuis la galerie"
      }
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#1B5E20",
          "sounds": [],
          "androidMode": "default",
          "androidCollapsedTitle": "KmerFret",
          "iosDisplayInForeground": true
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "KmerFret utilise votre position pour les missions de transport.",
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "KmerFret a besoin de la caméra pour scanner les documents et les QR Codes."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "KmerFret accède à vos photos pour importer des documents portuaires."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "KmerFret utilise Face ID pour une connexion rapide et sécurisée."
        }
      ],
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "DEFAULT"
        }
      ],
      "expo-sensors",
      "expo-sqlite",
      "expo-secure-store",
      "expo-localization",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.cm.kmerfret",
          "enableGooglePay": true
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "77eee8a1-7335-4627-8d49-20a0ca4c506f"
      }
    },
    "owner": "christlk"
  }
}
